{
  "port": 8082,
  "timeout": 30,
  "user": "",
  "pwd": "",
  "accessOrigin": "*",
  "defaultSkip": "",
  "session": {
    "secret": "please-change-this-secret-in-production",
    "name": "proxySession",
    "resave": false,
    "saveUninitialized": false,
    "cookie": { "maxAge": 86400000, "secure": false, "httpOnly": true }
  },
  "limiter": {
    "windowMs": 60000,
    "max": 60,
    "message": "Too many requests, please try again later.",
    "statusCode": 429
  },
  "blacklist": [],
  "max_redirects": 5
}
